# ThirdPlace backend — environment config.
# Copy to .env for local development. NEVER commit real values.
# All vars are prefixed TP_ (see backend/config.py).

TP_ENVIRONMENT=development
TP_APP_NAME=thirdplace-backend

# Redis broker/result backend for Celery.
TP_REDIS_URL=redis://localhost:6379/0

# Supabase (SERVER-SIDE ONLY). The service-role key must never reach a client.
# Left blank in Phase 0 — nothing is contacted.
TP_SUPABASE_URL=
TP_SUPABASE_SERVICE_ROLE_KEY=
